{
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "admin:create": "node scripts/create-admin.js",
    "server:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/server/setup-server.ps1",
    "server:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/server/start-server.ps1 -CheckOnly",
    "server:up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/server/start-server.ps1",
    "server:down": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/server/stop-server.ps1",
    "server:autostart:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/server/configure-autostart.ps1 -Action Install",
    "server:autostart:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/server/configure-autostart.ps1 -Action Status",
    "server:autostart:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/server/configure-autostart.ps1 -Action Start",
    "server:autostart:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/server/configure-autostart.ps1 -Action Stop",
    "server:autostart:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/server/configure-autostart.ps1 -Action Uninstall",
    "server:logs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/server/watch-logs.ps1",
    "db:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/server/backup-database.ps1",
    "db:backup:download": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/server/restore-database.ps1 -DownloadOnly",
    "db:restore": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/server/restore-database.ps1"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@tesseract.js-data/eng": "^1.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "multer": "^2.3.0",
    "mysql2": "^3.23.2",
    "pdfjs-dist": "^4.10.38",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  }
}
