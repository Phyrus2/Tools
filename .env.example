PORT= your port
DB_HOST= your host
DB_PORT= your db port
DB_USER= your username
DB_PASSWORD= your password
DB_NAME= your database name
# Origin only: no /Tools/ path or trailing slash.
CORS_ORIGINS=http://localhost:4200,https://YOUR_USERNAME.github.io
# Set true only when this backend is reachable exclusively through Cloudflare Tunnel.
TRUST_CLOUDFLARE_IP_HEADER=true

# Otomatisasi perpindahan PC server. SERVER_ID harus berbeda di setiap PC.
SERVER_ID=office
BACKUP_REMOTE=gdrive:C2I-Server-Backup
GITHUB_REPOSITORY=YOUR_USERNAME/YOUR_REPOSITORY

# Isi jika executable tidak tersedia melalui PATH.
RCLONE_PATH=.server-tools/rclone.exe
GH_PATH=.server-tools/gh.exe
NODE_PATH=node.exe
NPM_PATH=npm.cmd
CLOUDFLARED_PATH=cloudflare/cloudflared.exe
MYSQL_PATH=
MYSQLDUMP_PATH=

# Opsional, misalnya MySQL80. Kosongkan jika MySQL dijalankan lewat Laragon/XAMPP.
MYSQL_SERVICE_NAME=
